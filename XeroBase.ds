				Supplier_Name as "Supplier Name"
				Last_Restocked as "Last Restocked"
				Active
				Stock_Status
			)

		}
		list Upcoming_Orders_Report
		{
			displayName = "Upcoming_Orders_Report"
			show all rows from Print_Orders  [Order_Status != "Completed" && Order_Status != "Rejected" && Expected_Completion < zoho.currentdate]  
			(
				Order_ID as "Order ID"
				Customer
				Print_Type as "Print Type"
				Pages
				Copies
				Total_Amount as "Total Amount"
				Order_Status as "Order Status"
				Order_Priority as "Order Priority"
				Expected_Completion as "Expected Completion"
			)

		}
		kanban Order_Status_Kanban
		{
			displayName = "Order Status Kanban"
			show all rows from Print_Orders    
			(
				Order_ID as "Order ID"
				Customer
				Print_Type as "Print Type"
				Total_Amount as "Total Amount"
				Expected_Completion as "Expected Completion"
				Order_Status as "Order Status"
				Pages
				Copies
				Order_Priority as "Order Priority"
				Is_Overdue as "Is Overdue"
			)

			options
			(
	 			display field = Order_Status
				filter type  = manual
				record count  = enable
	 		)
		}
		kanban Inventory_Kanban
		{
			displayName = "Inventory_Kanban"
			show all rows from Inventory_Details    
			(
				Inventory_ID as "Inventory ID"
				Item_Name as "Item Name"
				Item_Category as "Item Category"
				Unit
				Opening_Stock as "Opening Stock"
				Current_Stock as "Current Stock"
				Reorder_Level as "Reorder Level"
				Unit_Cost as "Unit Cost"
				Supplier_Name as "Supplier Name"
				Last_Restocked as "Last Restocked"
				Stock_Status
				Active
			)

			options
			(
	 			display field = Item_Category
	 		)
		}
		calendar Transaction_Calender
		{
			displayName = "Transaction_Calender"
			show all rows from Loyalty_Transactions    
			(
				Transaction_ID as "Transaction ID"
				Customer
				Payment
				Points
				Transaction_Type as "Transaction Type"
				Transaction_Date as "Transaction Date"
				Notes
			)

			options
			(
				display field = Transaction_Date
				start date = Transaction_Date
			)
		}
		map Location_Report
		{
			displayName = "Location_Report"
			show all rows from Custom    
			(
				Customer_ID
				Customer_Name 
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Phone_Number1 as "Phone_Number"
				(
					displayformat = plainnumber
				)
				Email
				Loyalty_Points as "Loyalty Points"
				Customer_Category as "Customer Category"
				Feedback
				Sentimental_Analysis_Feedback
			)

			options
			(
	 			display field = Address
	 		)
			conditional formatting
			(
				"pin1"
				{
				condition = (Address.district_city == "Chennai")
				format = "color:#f6abbb;map-icon:users-2-woman;map-icon-color:#ffffff;"
				}
				"pin2"
				{
				condition = (Address.district_city == "Thanjavur")
				format = "color:#dfabf6;map-icon:users-2-woman;map-icon-color:#ffffff;"
				}
				"pin3"
				{
				condition = (Address.district_city == "Virudhunagar")
				format = "color:#aec6f8;map-icon:users-2-woman;map-icon-color:#ffffff;"
				}
			)
		}
		list All_Details
		{
			displayName = "All_Details"
			show all rows from Inventory_Details    
			(
				Inventory_ID as "Inventory ID"
				Item_Name as "Item Name"
				Item_Category as "Item Category"
				Unit
				Opening_Stock as "Opening Stock"
				Current_Stock as "Current Stock"
				Reorder_Level as "Reorder Level"
				Unit_Cost as "Unit Cost"
				Supplier_Name as "Supplier Name"
				Last_Restocked as "Last Restocked"
				Stock_Status
				Active
			)

		}
		pivotchart Sentiment_Chart
		{
			displayname = "Sentiment_Chart"
			based on Autoview_1793645966321_Custom
				show all rows from Custom
				(
			Customer_ID 
			Customer_Name 
 			(
 				first_name as "Customer_Name"
 				prefix as "Customer_Name.Prefix"
 				last_name as "Customer_Name.Last Name"
 				suffix as "Customer_Name.Suffix"
 			)
			Phone_Number1  as "Phone_Number"
			Email 
			Sentimental_Analysis_Feedback 
				)
		}
		pivottable Pivot_Table
		{
			displayname = "Pivot_Table"
			based on Autoview_1793652004849_Payment_Details
				show all rows from Payment_Details
				(
			Payment_ID 
			Order 
			Amount 
			Payment_Method 
			Payment_Status 
			Payment_Date_Time  as "Payment_Date-Time"
			Loyalty_Points_Awarded 
				)
		}
	}
