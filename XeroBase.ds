pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#FF7C89'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#0ABB51'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Order_Status == &quot;Ready&quot;'\n\t  value = 'thisapp.Print_Orders.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Ready for Pickup'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='27%'\n   \t>\n\t<panel elementName='Panel 9'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmargin = '0px'\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\tcolor = '#FFFFFF'\n\tbgColor = '#FFBCC1'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'files-2-docx'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#FF7C89'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'COMMA'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#0ABB51'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Print_Orders.Total_Amount.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Amount'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 8'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmargin = '0px'\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\tcolor = '#FFFFFF'\n\tbgColor = '#FFBCC1'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'files-2-docx'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#FF7C89'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#0ABB51'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Print_Orders.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Orders'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='24%'\n   \t>\n\t<panel elementName='Panel 7'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmargin = '0px'\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\tcolor = '#FFFFFF'\n\tbgColor = '#FFBCC1'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'files-2-docx'\n\tsize = '32px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#FF7C89'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#0ABB51'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Order_Status == &quot;Pending&quot;'\n\t  value = 'thisapp.Print_Orders.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '3px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Pending Orders'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 int Calculate_Loyalty_Points(float amount)
                 {
                 	basePoints = amount / 50;
                 	floorPoints = basePoints.floor();
                 	points = floorPoints.toLong();
                 	if(points < 0 || amount < 50)
                 	{
                 		points = 0;
                 	}
                 	return points;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Calculate_Print_Amount as "Calculate_Print_Amount"
			{
				type =  form
				form = Print_Orders

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											pricing = Pricing_Details[Print_Type == input.Print_Type && Active == true];
										if(pricing.count() > 0)
										{
											rate = pricing.Rate_Per_Page;
											input.Total_Amount = input.Pages * input.Copies * rate;
										}
										else
										{
											alert "No active price found for this print type. Please check Pricing Details.";
											cancel submit;
										}
						)
					}
				}

			}
			Validate_Print_Order as "Validate_Print_Order"
			{
				type =  form
				form = Print_Orders

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Pages <= 0)
										{
											alert "Pages must be greater than zero.";
											cancel submit;
										}
										if(input.Copies <= 0)
										{
											alert "Copies must be greater than zero.";
											cancel submit;
										}
						)
					}
				}

			}
			Validate_Payment as "Validate_Payment"
			{
				type =  form
				form = Payment_Details

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Amount < 0)
										{
											alert "Payment amount cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			}
			Update_Inventory_Stock as "Update_Inventory_Stock"
			{
				type =  form
				form = Stock_Movements

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity <= 0)
										{
											alert "Quantity must be greater than zero.";
											cancel submit;
										}
										itemRecord = Inventory_Details[ID == input.Inventory_Item];
										if(itemRecord.count() == 0)
										{
											alert "Please select a valid inventory item.";
											cancel submit;
										}
										if(input.Movement_Type == "Stock Out" && itemRecord.Current_Stock < input.Quantity)
										{
											alert "Insufficient stock available.";
											cancel submit;
										}
						)
					}
				}

			}
			Apply_Stock_Movement as "Apply_Stock_Movement"
			{
				type =  form
				form = Stock_Movements

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											itemRecord = Inventory_Details[ID == input.Inventory_Item];
										if(itemRecord.count() > 0)
										{
											if(input.Movement_Type == "Stock In")
											{
												itemRecord.Current_Stock=itemRecord.Current_Stock + input.Quantity;
											}
											else if(input.Movement_Type == "Stock Out")
											{
												itemRecord.Current_Stock=itemRecord.Current_Stock - input.Quantity;
											}
										}
						)
					}
				}

			}
			Update_Stock_Status as "Update_Stock_Status"
			{
				type =  form
				form = Inventory_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Current_Stock <= input.Reorder_Level)
										{
											input.Stock_Status = "Low Stock";
										}
										else
										{
											input.Stock_Status = "In Stock";
										}
						)
					}
				}

			}
			Award_Customer_Loyalty_Po as "Award_Customer_Loyalty_Points"
			{
				type =  form
				form = Payment_Details

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Payment_Status == "Paid" && input.Loyalty_Points_Awarded == false && input.Amount >= 50)
										{
											orderRecord = Print_Orders[ID == input.Order];
											if(orderRecord.count() > 0)
											{
												customerRecord = Custom[ID == orderRecord.Customer];
												if(customerRecord.count() > 0)
												{
													existingTransaction = Loyalty_Transactions[Payment == input.ID];
													if(existingTransaction.count() == 0)
													{
														points = thisapp.Calculate_Loyalty_Points(input.Amount);
														insert into Loyalty_Transactions
														[
															Customer=customerRecord.ID
															Payment=input.ID
															Points=points
															Transaction_Type="Earned"
															Transaction_Date=zoho.currenttime
															Notes="Loyalty points awarded for paid payment"
															Added_User=zoho.loginuser
														]
														customerRecord.Loyalty_Points=ifnull(customerRecord.Loyalty_Points,0) + points;
														input.Loyalty_Points_Awarded = true;
													}
												}
											}
										}
						)
					}
				}

			}
			Update_Customer_Category as "Update_Customer_Category"
			{
				type =  form
				form = Custom

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											points = input.Loyalty_Points;
										if(points >= 50)
										{
											input.Customer_Category = "VIP";
										}
										else if(points >= 10)
										{
											input.Customer_Category = "Frequent";
										}
										else
										{
											input.Customer_Category = "Regular";
										}
						)
					}
				}

			}
			Check_Order_Deadline as "Check_Order_Deadline"
			{
				type =  form
				form = Print_Orders

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Order_Status != "Completed" && input.Order_Status != "Rejected" && input.Expected_Completion != null && input.Expected_Completion < zoho.currenttime)
										{
											input.Is_Overdue = true;
										}
										else
										{
											input.Is_Overdue = false;
										}
						)
					}
				}

			}
			CRM as "CRM"
			{
				type =  form
				form = Custom

				record event = on add or edit

				on success
				{
					actions 
					{
							ZohoCRM.v2.createContact(data:{"Email":"Email","Last_Name":"Customer_Name.last_name"},connection:"zoho_crm_connection");
					}
				}

			}
		}

		schedule
		{
			Daily_Overdue_Order_Check as "Daily_Overdue_Order_Check"
			{
				type =  schedule
					status = inactive
				start = "2026-10-21 22:43:25"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						orders = Print_Orders[ID != 0];
										for each  orderRecord in orders
										{
											if(orderRecord.Expected_Completion != null)
											{
												if(orderRecord.Expected_Completion < zoho.currenttime && orderRecord.Order_Status != "Completed" && orderRecord.Order_Status != "Rejected")
												{
													orderRecord.Is_Overdue=true;
												}
												else
												{
													orderRecord.Is_Overdue=false;
												}
											}
										}
					)
					}
				}
			}
			Daily_Overdue_Email_Notification as "Daily Overdue Email Notification"
			{
				type =  schedule
					status = inactive
				start = "2026-10-28 09:55:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						overdueOrders = Print_Orders[Is_Overdue == true];
										if(overdueOrders.count() > 0)
										{
											messageContent = "<h2>Overdue Print Orders Summary</h2><p>The following orders are overdue:</p><ul>";
											for each  order in overdueOrders
											{
												customerName = order.Customer.Customer_Name.first_name + " " + order.Customer.Customer_Name.last_name;
												expectedDate = toString(order.Expected_Completion,"dd-MMM-yyyy");
												messageContent = messageContent + "<li><strong>Order ID:</strong> " + order.Order_ID + " - <strong>Customer:</strong> " + customerName + " - <strong>Expected Date:</strong> " + expectedDate + " - <strong>Status:</strong> " + order.Order_Status + "</li>";
											}
											messageContent = messageContent + "</ul><p>Total Overdue Orders: " + overdueOrders.count() + "</p>";
											adminEmail = thisapp.permissions.adminEmailIds();
											sendmail
											[
												from :zoho.adminuserid
												to :adminEmail
												subject :"Overdue Print Orders Alert - " + today
												message :messageContent
												content type :HTML
											]
										}
										else
										{
											info "No overdue orders found.";
										}
					)
					}
				}
			}
		}

		approval
		{
			Print_Order_Approval as "Print_Order_Approval"
			{
				type =  approval
				form = Print_Orders
				display fields = [Order_ID,Customer,Print_Type,Pages,Copies,Total_Amount,Order_Status]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						update Print_Orders[ID == input.ID]
						[
							Order_Status = "Accepted"
						]
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						update Print_Orders[ID == input.ID]
						[
							Order_Status = "Rejected"
						]
						}
					}
				}
			}
		}



	}
