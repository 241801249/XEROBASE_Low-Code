 * Version      : 1.0
 */
 application "XeroBase"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Custom
		{
			displayname = "Customer_Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Customer_ID
			(
    			type = autonumber
				start index = 2722
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone_Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Loyalty_Points
			(
				type = number
				displayname = "Loyalty Points"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Category
			(
				type = picklist
				displayname = "Customer Category"
				maxchar = 100
				values = {"Regular","Frequent","VIP"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Feedback
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sentimental_Analysis_Feedback
			(
				type = picklist
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = SentimentAnalysis
									basefield = Feedback
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Document_Details
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Document_ID
			(
    			type = autonumber
				start index = 1427
	 			row = 1
	 			column = 1   
				width = medium
			)
			Orders
			(
				type = picklist	
				displayname = "Order"
				values  = Print_Orders.ID
    			displayformat = [Order_ID + " - " + Print_Type]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Document_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			File_Type
			(
				type = picklist
				maxchar = 100
				values = {"PDF","DOCX","JPG","PNG"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Page_Count
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Document_Status
			(
				type = picklist
				maxchar = 100
				values = {"Verified","Pending","Rejected"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			OCR_Extracted_Text
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = small
						AI_Properties
						(
									fieldtype = OCR
									basefield = Document_File
						)
			)
			Document_File
			(
    			type = upload file
				browse = local_drive
				allowed file formats = {"jpg","pdf","tiff","png"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Inventory_Details
		{
			displayname = "Inventory Details"
			success message = "Inventory Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Inventory_ID
			(
    			type = autonumber
				displayname = "Inventory ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Item_Name
			(
    			type = text
				displayname = "Item Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Item_Category
			(
				type = picklist
				displayname = "Item Category"
				maxchar = 100
				values = {"Paper","Binding Material"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Unit
			(
				type = picklist
				maxchar = 100
				values = {"Ream","pack","Piece"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Opening_Stock
			(
				type = number
				displayname = "Opening Stock"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Current_Stock
			(
				type = number
				displayname = "Current Stock"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reorder_Level
			(
				type = number
				displayname = "Reorder Level"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit_Cost
			(
				displayname = "Unit Cost"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supplier_Name
			(
    			type = text
				displayname = "Supplier Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Restocked
			(
    			type = date
				displayname = "Last Restocked"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Stock_Status
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Loyalty_Transactions
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Transaction_ID
			(
    			type = autonumber
				displayname = "Transaction ID"
				start index = 333
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer
			(
				type = picklist	
				values  = Custom.ID
    			displayformat = [" " + Customer_Name.prefix + " " + Customer_Name.first_name + " " + Customer_Name.last_name + " " + Customer_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment
			(
				type = picklist	
				values  = Payment_Details.ID
    			displayformat = [Amount]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Points
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transaction_Type
			(
				type = picklist
				displayname = "Transaction Type"
				maxchar = 100
				values = {"Earned","Redeemed","Adjustment"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transaction_Date
			(
    			type = datetime
				displayname = "Transaction Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
    			description
    			[
    				type = tooltip
    			 	message = "Optional explanation"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Payment_Details
		{
			displayname = "Payment Details"
			success message = "Payment Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Payment_ID
			(
    			type = autonumber
				start index = 154
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Order
			(
				type = picklist	
				values  = Print_Orders.ID
    			displayformat = [Order_ID + " - " + Total_Amount]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Amount
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Payment_Method
			(
				type = picklist
				maxchar = 100
				values = {"Cash","UPI","Card"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Payment_Status
			(
				type = radiobuttons
				maxchar = 100
				values = {"pending","Paid","Failed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Date_Time
			(
    			type = datetime
				displayname = "Payment_Date-Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Loyalty_Points_Awarded
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Pricing_Details
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Pricing_Details
			(
    			type = autonumber
				start index = 27
	 			row = 1
	 			column = 1   
				width = medium
			)
			Print_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Black & White","Colour"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Rate_Per_Page
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Paper_Size
			(
				type = picklist
				maxchar = 100
				values = {"A4","A3"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Binding_Charge
			(
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Print_Orders
		{
			displayname = "Print Orders"
			success message = "Order Printed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Order_ID
			(
    			type = autonumber
				displayname = "Order ID"
				start index = 501
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer
			(
				type = picklist	
				values  = Custom.ID
    			displayformat = [" " + Customer_ID + " " + Customer_Name.first_name + " " + Customer_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Print_Type
			(
				type = radiobuttons
				displayname = "Print Type"
				maxchar = 100
				values = {"Black & White","Colour"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Pages
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Copies
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Amount
			(
				displayname = "Total Amount"
				type = INR
				format = commadotindian
				decimalplace = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Order_Status
			(
				type = picklist
				displayname = "Order Status"
				maxchar = 100
				values = {"Pending","Accepted","Printing","Ready","Completed","Rejected"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Order_Priority
			(
				type = picklist
				displayname = "Order Priority"
				maxchar = 100
				values = {"Normal","High","Urgent"}
				initial value = "Normal"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expected_Completion
			(
    			type = date
				displayname = "Expected Completion"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Overdue
			(
    			type = checkbox
				displayname = "Is Overdue"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Order_Priority_Prediction
			(
    			type = text
				displayname = "AI_Order_Priority"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = Prediction
									modelname = "PREDICTION_PRIORITY"
									supportingfield = {Copies,Expected_Completion,Order_Status,Pages,Print_Type}
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Print"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Stock_Movements
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Movement_ID
			(
    			type = autonumber
				displayname = "Movement ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inventory_Item
			(
				type = picklist	
				displayname = "Inventory Item"
				values  = Inventory_Details.ID
    			displayformat = [Item_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Movement_Type
			(
				type = picklist
				displayname = "Movement Type"
				maxchar = 100
				values = {"Stock In","Stock Out","Adjustment"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = number
    			description
    			[
    				type = help_text
    			 	message = "Positive Number Only"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Movement_Date
			(
    			type = date
				displayname = "Movement Date"
				initial value = "21-Oct-2026"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference
			(
    			type = text
    			description
    			[
    				type = help_text
    			 	message = "Invoice, order, or reason"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
    			description
    			[
    				type = help_text
    			 	message = "Optional explanation"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Loyalty_Customers_Report
		{
			displayName = "Loyalty_Customers_Report"
			show all rows from Custom    
			(
				Customer_Name 
				Customer_ID
				Phone_Number1 as "Phone_Number"
				(
					displayformat = plainnumber
				)
				Email
				Loyalty_Points as "Loyalty Points"
				Customer_Category as "Customer Category"
				Feedback
				Sentimental_Analysis_Feedback
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)

		}
		default list All_Orders
		{
			displayName = "All Orders"
			show all rows from Print_Orders    
			(
				Order_ID as "Order ID"
				Customer
				Print_Type as "Print Type"
				Pages
				Copies
				Total_Amount as "Total Amount"
				Order_Status as "Order Status"
				Order_Priority as "Order Priority"
				Expected_Completion as "Expected Completion"
				Is_Overdue as "Is Overdue"
				Order_Priority_Prediction as "AI_Order_Priority"
			)

		}
		default list All_Payment_Details
		{
			displayName = "All Payment Details"
			show all rows from Payment_Details    
			(
				Payment_ID
				Order
				Amount
				Payment_Method
				Payment_Status
				Payment_Date_Time as "Payment_Date-Time"
				Loyalty_Points_Awarded
			)

		}
		list All_Print_Orders
		{
			displayName = "All_Print_Orders"
