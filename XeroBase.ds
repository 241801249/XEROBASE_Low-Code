borderWidth = '0px'\n\n\t  value = 'Open Customer Dashboard'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'OpenPage'\n\t\tcomponentLinkName = 'Customer_Dashboard'\n\t\ttarget = 'new-window'\n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '2px'\n\tpadding = '0px'\n\tcolor = '#FFA0A8'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#4C7DE8'\n    borderWidth = '0px'\n\n\t  value = 'Customer Portal \u2192'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Scatter'\n\tbgColor = '#FFFFFF'\n\ttheme = '#CF6C59'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Custom'\n\txfield = 'Loyalty_Points'\n\tyfields = 'count:Customer_ID'\n/>\n\n</column>\n</row>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<gauge \n\telementName='Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#E64F00'\n\tdisplayType = 'actual'\n\ttype = '3'\n\tvalue = 'thisapp.Payment_Details.Amount.sum'\n>\n<target size=\"15px\" color=\"#7F7F7F\" fontFamily=\"default\" value=\"2500\"\n/><ranges>\n\t\t\t<range color=\"#FFDDCB\" width=\"50\" />\n\t\t<range color=\"#FFBB97\" width=\"50\" />\n</ranges><maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"5000\" \n/>\n</gauge>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 6'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n